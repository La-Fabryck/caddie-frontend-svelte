{
	"name": "caddie-frontend-svelte",
	"version": "0.2.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "concurrently -n \"VITE,SVELTE-CHECK\" -c \"blue,green\" \"npm run dev:vite\" \"npm run dev:watch\"",
		"dev:vite": "vite dev",
		"dev:watch": "npm run check -- --watch",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --incremental",
		"lint": "npm run check:oxfmt -- . && npm run check:eslint -- .",
		"format": "npm run fix:oxfmt -- . && npm run fix:eslint -- .",
		"check:oxfmt": "oxfmt --check",
		"check:eslint": "NODE_OPTIONS=\"--disable-warning=ESLintPoorConcurrencyWarning\" eslint --cache --cache-strategy content --concurrency 4 --max-warnings 0",
		"fix:oxfmt": "oxfmt --write",
		"fix:eslint": "NODE_OPTIONS=\"--disable-warning=ESLintPoorConcurrencyWarning\" eslint --cache --cache-strategy content --concurrency 4 --max-warnings 0 --fix",
		"typecheck": "npm run check",
		"test": "npm run test:unit -- --run"
	},
	"devDependencies": {
		"@eslint/compat": "^2.1.0",
		"@eslint/js": "^10.0.1",
		"@internationalized/date": "^3.12.3",
		"@lucide/svelte": "^1.37.0",
		"@sveltejs/adapter-node": "^5.5.7",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^26",
		"@typescript-eslint/parser": "^8.68.0",
		"@vitest/browser-playwright": "^4.1.11",
		"bits-ui": "^2.19.0",
		"clsx": "^2.1.1",
		"concurrently": "^10.0.5",
		"eslint": "^10.9.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.0",
		"formsnap": "^2.0.1",
		"globals": "^17.11.0",
		"lefthook": "^2.1.12",
		"oxfmt": "^0.65.0",
		"playwright": "^1.62.1",
		"svelte": "^5.57.0",
		"svelte-check": "^4.7.6",
		"sveltekit-superforms": "^2.30.2",
		"tailwind-merge": "^3.6.0",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4.3.3",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.68.0",
		"vite": "^8.2.2",
		"vitest": "^4.1.11",
		"vitest-browser-svelte": "^3.0.0"
	},
	"engines": {
		"node": ">=26",
		"npm": ">=11.15.0"
	},
	"allowScripts": {
		"fsevents": false,
		"lefthook": true
	}
}
