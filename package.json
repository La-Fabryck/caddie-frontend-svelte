{
	"name": "caddie-frontend-svelte",
	"version": "0.2.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "concurrently -n \"VITE,SVELTE-CHECK\" -c \"blue,green\" \"npm run dev:vite\" \"npm run dev:watch\"",
		"dev:vite": "vite dev",
		"dev:watch": "npm run check -- --watch",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo '' && husky",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"format": "oxfmt --write . && eslint --fix .",
		"lint": "oxfmt --check . && eslint .",
		"typecheck": "npm run check",
		"test": "npm run test:unit -- --run"
	},
	"devDependencies": {
		"@eslint/compat": "^2.1.0",
		"@eslint/js": "^10.0.1",
		"@internationalized/date": "^3.12.2",
		"@lucide/svelte": "^1.24.0",
		"@sveltejs/adapter-node": "^5.5.7",
		"@sveltejs/kit": "^2.69.2",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/vite": "^4.3.2",
		"@types/node": "^26",
		"@typescript-eslint/parser": "^8.63.0",
		"@vitest/browser-playwright": "^4.1.10",
		"bits-ui": "^2.18.1",
		"clsx": "^2.1.1",
		"concurrently": "^10.0.3",
		"eslint": "^10.6.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.20.0",
		"formsnap": "^2.0.1",
		"globals": "^17.7.0",
		"husky": "^9.1.7",
		"nano-staged": "^1.0.2",
		"oxfmt": "^0.58.0",
		"playwright": "^1.61.1",
		"svelte": "^5.56.4",
		"svelte-check": "^4.7.2",
		"sveltekit-superforms": "^2.30.2",
		"tailwind-merge": "^3.6.0",
		"tailwind-variants": "^3.2.2",
		"tailwindcss": "^4.3.2",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.63.0",
		"vite": "^8.1.4",
		"vitest": "^4.1.10",
		"vitest-browser-svelte": "^3.0.0"
	},
	"nano-staged": {
		"*.{js,ts,svelte}": [
			"oxfmt --write",
			"eslint --fix"
		],
		"*.{json,css,md,html,yml,yaml}": "oxfmt --write"
	},
	"engines": {
		"node": ">=26",
		"npm": ">=11.15.0"
	},
	"allowScripts": {
		"fsevents": false
	}
}
