{
	"name": "caddie-frontend-svelte",
	"version": "0.4.0",
	"private": true,
	"type": "module",
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "concurrently -n \"VITE,SVELTE-CHECK\" -c \"blue,green\" \"npm run dev:vite\" \"npm run dev:watch\"",
		"dev:vite": "vite dev",
		"dev:watch": "npm run check -- --watch",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --incremental",
		"lint": "npm run check:oxfmt -- . && npm run check:eslint -- .",
		"format": "npm run fix:oxfmt -- . && npm run fix:eslint -- .",
		"check:oxfmt": "oxfmt --check",
		"check:eslint": "NODE_OPTIONS=\"--disable-warning=ESLintPoorConcurrencyWarning\" eslint --cache --cache-strategy content --concurrency 4 --max-warnings 0",
		"fix:oxfmt": "oxfmt --write",
		"fix:eslint": "NODE_OPTIONS=\"--disable-warning=ESLintPoorConcurrencyWarning\" eslint --cache --cache-strategy content --concurrency 4 --max-warnings 0 --fix",
		"typecheck": "npm run check",
		"test": "npm run test:unit -- --run"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@internationalized/date": "^3.12.4",
		"@lucide/svelte": "^1.61.0",
		"@sveltejs/adapter-node": "^6.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/load-config": "^0.2.2",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^26",
		"@typescript-eslint/parser": "^8.72.0",
		"@vitest/browser-playwright": "^5.0.5",
		"bits-ui": "^2.20.2",
		"clsx": "^2.1.1",
		"concurrently": "^10.0.6",
		"eslint": "^10.13.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.1",
		"formsnap": "^2.1.0",
		"globals": "^17.13.0",
		"lefthook": "^2.2.2",
		"oxfmt": "^0.73.0",
		"playwright": "^1.64.1",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.7",
		"sveltekit-superforms": "^3.0.0",
		"tailwind-merge": "^3.7.0",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4.3.3",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.72.0",
		"vite": "^8.3.5",
		"vitest": "^5.0.5",
		"vitest-browser-svelte": "^3.1.0"
	},
	"engines": {
		"node": ">=26",
		"npm": ">=11.15.0"
	},
	"allowScripts": {
		"fsevents": false,
		"lefthook": true
	}
}
